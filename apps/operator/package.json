{
  "name": "@sdiqt/operator",
  "version": "0.1.0",
  "description": "SDIQT sequencer: batch trigger, dual self-check, shadow and live submission",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "sdiqt-operator": "./src/cli.ts",
    "sdiqt-accounts": "./src/accounts-cli.ts"
  },
  "scripts": {
    "operator": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "0.39.0",
    "@cosmjs/stargate": "0.39.0",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/rdk": "0.9.0",
    "@qorechain/sdk": "0.10.0",
    "@sdiqt/archiver": "workspace:*",
    "@sdiqt/chain": "workspace:*",
    "@sdiqt/protocol": "workspace:*",
    "@sdiqt/verify": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "vitest": "5.1.1"
  }
}
